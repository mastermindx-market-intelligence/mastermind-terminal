rgb, 100 160 255) / 0.12);border-radius:var(--r-sm);padding:2px 6px;white-space:nowrap">T2</span><span style="font:500 11px/1.4 var(--font-ui);color:var(--text-2);flex:1;text-decoration:none;opacity:1">Trim again.</span></div><span style="flex-shrink:0;font:600 9.5px/1 var(--font-ui);border:1px solid;border-radius:var(--r-pill);padding:3px 8px;white-space:nowrap;color:var(--text-dim);border-color:var(--text-dim)55">PENDING</span></div></div></div><div style="background:linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.018));border:1px solid rgba(255,255,255,0.095);border-radius:14px;padding:14px 15px;margin-bottom:12px;box-shadow:inset 0 1px 0 rgba(255,255,255,.035)" class="obs-card obs-prophet-section"><div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:9px;gap:8px;flex-wrap:wrap"><span class="obs-lbl" style="font:600 10.5px/1 var(--font-ui);color:var(--text-2);text-transform:uppercase;letter-spacing:.10em">Signal Thesis</span><span style="font:500 9px/1 var(--font-ui);color:var(--muted);font-style:italic">Built from the plan&#x27;s published signal inputs</span></div><p style="font:500 11.5px/1.65 var(--font-ui);color:var(--text-2);margin:0;white-space:pre-wrap">Rideshare margins are re-rating.</p><p style="margin:9px 0 0;padding-top:8px;border-top:1px solid var(--hairline);font:500 10.5px/1.5 var(--font-ui);color:var(--text-2)"><span style="color:var(--warn);font-weight:700">Dealer positioning — context overlay: </span>Dealer positioning is light above T1.</p></div><section class="_container_8b25b6" data-testid="bottom-pivot-evidence"><button type="button" class="_toggle_8b25b6" aria-expanded="false" aria-controls="_R_8_" data-testid="bottom-pivot-toggle"><span>Daily pivot evidence</span><span class="_chevron_8b25b6" aria-hidden="true">+</span></button></section></div>"`;

