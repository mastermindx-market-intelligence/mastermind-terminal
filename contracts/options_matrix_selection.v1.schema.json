{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mastermind:options_matrix_selection:v1",
  "title": "Options matrix selection v1 \u2014 candidate structural contract",
  "$comment": "Qualification artifact only. Not runtime admission or a persistence, rights, source identity, or retained-membership authority. Future Investigation v3 owns integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "primary",
    "comparisons",
    "view"
  ],
  "properties": {
    "schema": {
      "const": "options_matrix_selection.v1"
    },
    "primary": {
      "$ref": "#/$defs/coordinate"
    },
    "comparisons": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/coordinate"
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "metric",
        "side",
        "expiry",
        "display_mode"
      ],
      "properties": {
        "lens": {
          "const": "chain"
        },
        "metric": {
          "enum": [
            "volume",
            "openInterest",
            "deltaOi"
          ]
        },
        "side": {
          "enum": [
            "all",
            "call",
            "put"
          ]
        },
        "expiry": {
          "anyOf": [
            {
              "const": "all"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        },
        "display_mode": {
          "enum": [
            "3d",
            "table"
          ]
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
      "format": "date"
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expiry",
        "side",
        "strike"
      ],
      "properties": {
        "expiry": {
          "$ref": "#/$defs/date"
        },
        "side": {
          "enum": [
            "call",
            "put"
          ]
        },
        "strike": {
          "type": "string",
          "maxLength": 21,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{0,7}[1-9])?(?![\\s\\S])",
          "not": {
            "const": "0"
          }
        }
      }
    }
  }
}
