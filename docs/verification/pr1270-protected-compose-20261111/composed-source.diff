+++ b/.github/workflows/ci.yml
@@ -417,11 +417,9 @@ jobs:
           set -euo pipefail
           BASE=$(git rev-parse HEAD^1)
           git diff --name-only --no-renames "${BASE}" HEAD > "${RUNNER_TEMP}/evidence-pr-touched.txt"
-          {
-            echo "EVIDENCE_PR_TOUCHED_FILE<<__mmx-evidence-touched-eof__"
