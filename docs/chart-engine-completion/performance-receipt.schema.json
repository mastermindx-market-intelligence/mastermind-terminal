{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/schemas/chart-engine/performance-receipt.json",
  "title": "Chart engine performance receipt",
  "description": "One measurement run of the chart-engine performance budget (docs/chart-engine-completion/performance-budget.md). Emitted per impl (mm | lwc) per commit per host; a green mm receipt gates the P4 default flip.",
  "type": "object",
  "required": [
    "commit",
    "generated_at",
    "host",
    "corpus",
    "metrics",
    "budget_ok",
    "violations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "budget_ok": { "const": true } },
        "required": ["budget_ok"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "first_paint_ms": { "maximum": 150 },
              "pan_frame_p95_ms": { "maximum": 18 },
              "zoom_frame_p95_ms": { "maximum": 18 },
              "live_commit_ms": { "maximum": 4 },
              "screenshot_ms": { "maximum": 50 },
              "heap_mb": { "maximum": 60 }
            }
          },
          "violations": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "budget_ok": { "const": false } },
        "required": ["budget_ok"]
      },
      "then": {
        "properties": {
          "violations": { "minItems": 1 }
        }
      }
    }
  ],
  "properties": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "HEAD sha the renderer under test was built from."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the run."
    },
    "host": {
      "type": "object",
      "required": ["os", "cpu", "dpr"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. 'linux 6.0.0-34-generic'."
        },
        "cpu": {
          "type": "string",
          "minLength": 1,
          "description": "Model/core summary, e.g. '12 x AMD Ryzen 9'."
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "deviceScaleFactor of the measured page (protocol pins 2)."
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["name", "bars"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Corpus identifier, e.g. 'daily-40k'."
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "description": "Row count of the primary series."
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Medians of per-run p95s (max for heap_mb), protocol section 3.",
      "required": [
        "first_paint_ms",
        "pan_frame_p95_ms",
        "zoom_frame_p95_ms",
        "live_commit_ms",
        "screenshot_ms",
        "heap_mb"
      ],
      "additionalProperties": false,
      "properties": {
        "first_paint_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "B1: createEngine entry to first presented frame. Budget 150 (enforced when budget_ok)."
        },
        "pan_frame_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "B2: p95 inter-frame delta while drag-panning. Budget 18 (enforced when budget_ok)."
        },
        "zoom_frame_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "B3: p95 inter-frame delta while wheel-zooming. Budget 18 (enforced when budget_ok)."
        },
        "live_commit_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "B4: p95 update() call to next presented frame. Budget 4 (enforced when budget_ok)."
        },
        "screenshot_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "B5: p95 synchronous takeScreenshot() at 1440x900 dpr2. Budget 50 (enforced when budget_ok)."
        },
        "heap_mb": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "B6: per-chart JS heap delta in MB. Budget 60 (enforced when budget_ok)."
        }
      }
    },
    "budget_ok": {
      "type": "boolean",
      "description": "True iff every metric is within budget; must equal (violations length === 0)."
    },
    "violations": {
      "type": "array",
      "description": "Empty when budget_ok; otherwise one entry per breached budget.",
      "items": {
        "type": "object",
        "required": ["metric", "value", "budget"],
        "additionalProperties": false,
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "first_paint_ms",
              "pan_frame_p95_ms",
              "zoom_frame_p95_ms",
              "live_commit_ms",
              "screenshot_ms",
              "heap_mb"
            ]
          },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "budget": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
