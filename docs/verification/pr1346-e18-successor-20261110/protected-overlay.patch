+++ b/terminal/e2e/discover-focus-continuity.spec.ts
@@ -0,0 +1,41 @@
+import { expect, test } from "@playwright/test";
+
+// The chooser exists only in the established beta presentation. CI runs this
+// specification in its explicit Shared Shell qualification as well as discovery.
+test.skip(process.env.MMX_SHARED_SHELL !== "1", "Shared Shell is an explicit beta opt-in");
+
+for (const lang of ["en", "zh"] as const) {
+  test(`Discover chooser keeps keyboard focus with the selected task (${lang})`, async ({ page, baseURL }, info) => {
+    test.setTimeout(90_000);
+    await page.addInitScript(value => localStorage.setItem("mm.lang", value), lang);
+    await page.context().addCookies([{ name: "mm_e2e_rs30", value: "1", url: baseURL! }]);
+    await page.goto("/discover");
+    const heading = page.getByRole("heading", { name: lang === "zh" ? "发现" : "Discover", exact: true });
+    await expect(heading).toBeVisible({ timeout: 30_000 });
+
+    for (const [label, key] of [[lang === "zh" ? "打开热图" : "Open Heatmap", "heatmap"], [lang === "zh" ? "打开研究" : "Open study", "rs-pivot"]]) {
+      const launch = page.getByRole("button", { name: label, exact: true });
+      await expect(launch).toBeEnabled();
+      await launch.focus();
+      const outerScroll = await page.evaluate(() => ({ x: scrollX, y: scrollY }));
+      await launch.press("Enter");
+      const tab = page.locator(`#wtab-${key}`);
+      await expect(tab).toHaveAttribute("aria-selected", "true");
+      await expect(tab).toBeFocused();
+      await expect.poll(() => tab.evaluate(node => {
+        const rail = node.closest('[role="tablist"]')!.getBoundingClientRect();
+        const box = node.getBoundingClientRect();
+        return box.left >= rail.left - 1 && box.right <= rail.right + 1;
+      })).toBe(true);
+      expect(await page.evaluate(() => ({ x: scrollX, y: scrollY }))).toEqual(outerScroll);
+      await page.screenshot({ path: info.outputPath(`discover-${key}-${lang}-${info.project.name}.png`) });
+
+      const back = page.locator(".discover-chooser-back");
+      await back.focus(); await back.press("Enter");
+      await expect(heading).toBeFocused(); await expect(heading).toBeVisible();
+      await page.keyboard.press("Tab");
+      await expect(page.locator(".discover-chooser-shell").getByRole("button", { name: lang === "zh" ? "搜索公司" : "Search companies", exact: true })).toBeFocused();
+      expect(await page.evaluate(() => ({ x: scrollX, y: scrollY }))).toEqual(outerScroll);
+    }
+  });
+}
diff --git a/terminal/e2e/search-return-focus.spec.ts b/terminal/e2e/search-return-focus.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1642701769e284dff08e816fc4c7dd01f435d36a
--- /dev/null
+++ b/terminal/e2e/search-return-focus.spec.ts
@@ -0,0 +1,86 @@
+import { expect, test, type Locator, type Page, type TestInfo } from "@playwright/test";
+import { E2E_WL_NOTES_KEY, isolateWatchlistStore } from "./watchlistStore";
+
+async function roundtrip(page: Page, opener: Locator, input: Locator, info: TestInfo, scope: string) {
+  const original = page.viewportSize()!;
+  const alternate = original.width <= 600 ? { width: 1440, height: 900 } : { width: 390, height: 844 };
+  const outerScroll = await page.evaluate(() => ({ x: scrollX, y: scrollY }));
+  await opener.click(); await input.fill("AAPL");
+  for (const viewport of [alternate, original]) {
+    await page.setViewportSize(viewport); await expect(input).toBeVisible(); await expect(input).toHaveValue("AAPL");
+  }
+  await page.keyboard.press("Escape"); await expect(input).toBeHidden(); await expect(opener).toBeFocused();
+  expect(await page.evaluate(() => ({ x: scrollX, y: scrollY }))).toEqual(outerScroll);
+  await page.screenshot({ path: info.outputPath(`${scope}-return-${info.project.name}.png`) });
+  // A second ordinary session must not reuse a detached presentation target.
+  await opener.click(); await expect(input).toBeVisible();
+  await page.keyboard.press("Escape"); await expect(input).toBeHidden(); await expect(opener).toBeFocused();
+}
+
+test("ordinary Search restores its opener across responsive presentations", async ({ page }, info) => {
+  test.setTimeout(90_000);
+  await page.addInitScript(() => localStorage.setItem("mm.lang", "en"));
+  await page.goto("/terminal?symbol=NVDA");
+  await expect(page.locator(".mm-ptag")).toBeVisible({ timeout: 60_000 });
+  const opener = info.project.name === "desktop" ? page.locator(".pair").first() : page.locator(".m-symbar [data-symbol-search]");
+  await roundtrip(page, opener, page.locator(".sh input"), info, "ordinary");
+});
+
+test("Shared Search restores its opener across responsive presentations", async ({ page }, info) => {
+  test.setTimeout(90_000);
+  test.skip(process.env.MMX_SHARED_SHELL !== "1", "Existing Shared Shell beta opt-in");
+  await page.addInitScript(() => localStorage.setItem("mm.lang", "en"));
