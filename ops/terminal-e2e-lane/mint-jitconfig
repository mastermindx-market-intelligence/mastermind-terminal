#!/usr/bin/python3 -I
"""Terminal e2e lane: mint one-job JIT runner configs, or read back the lane's state.

Runs only as `ghmint`, the one account that can read the org credential at
/etc/ghmint/token (docs/CI_TERMINAL_E2E_SELFHOSTED_LANE.md, "Registering a slot").
  mint   <name> <labels> <group_id>  -> writes ONLY the encoded JIT config to stdout
  status <group_id>                  -> runner name / status / busy / labels in the group
  check  <group_id>                  -> group name, visibility, public-repo flag, repo list
Never prints the credential. Errors carry HTTP status codes only.

Exit codes: 0 success; 75 API/network failure (the slot backs off and retries);
3 a same-name registration an operator must reconcile; 2 bad input. The slot stops on
anything but 0 and 75.
"""
import http.client
import json
import re
import sys
import urllib.error
import urllib.request

ORG = "mastermindx-market-intelligence"
TOKEN_PATH = "/etc/ghmint/token"
API = "https://api.github.com"
NAME_RE = re.compile(r"^ubuntu0-e2e-[1-9]$")
LABELS = "self-hosted,linux,x64,ubuntu0-e2e"
PER_PAGE = 100
MAX_PAGES = 20
EX_TEMPFAIL = 75
EX_RECONCILE = 3
EX_USAGE = 2


def _exit(code, message):
    print("mint: " + message, file=sys.stderr)
    sys.exit(code)


def _token():
    with open(TOKEN_PATH, encoding="utf-8") as fh:
        value = fh.read().strip()
    if not value:
        _exit(EX_RECONCILE, "credential file is empty")
    return value


def _call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method, headers={
        "Authorization": "Bearer " + _token(),
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "terminal-e2e-lane-mint",
    })
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as err:
        return err.code, None
    except (OSError, http.client.HTTPException) as err:  # URLError, timeouts, TLS, resets
        _exit(EX_TEMPFAIL, f"network error {type(err).__name__}")


def _gid(arg):
    if not arg.isdigit():
        _exit(EX_USAGE, "group id must be digits")
    return int(arg)


def _list_all(path, key):
    """Every item of a paginated list endpoint, or exit: a partial list is never used."""
    items = []
    for page in range(1, MAX_PAGES + 1):
        sep = "&" if "?" in path else "?"
        status, data = _call("GET", f"{path}{sep}per_page={PER_PAGE}&page={page}")
        if status != 200:
            _exit(EX_TEMPFAIL, f"list {key} HTTP {status}")
        batch = data.get(key) if isinstance(data, dict) else None
        total = data.get("total_count") if isinstance(data, dict) else None
        if not isinstance(batch, list) or not isinstance(total, int) or isinstance(total, bool):
            _exit(EX_RECONCILE, f"list {key}: unexpected response shape")
        items.extend(batch)
        if len(items) >= total or not batch:
            if len(items) != total:
                _exit(EX_TEMPFAIL, f"list {key}: got {len(items)} of {total} (list changed while paging)")
            return items
    _exit(EX_RECONCILE, f"list {key}: more than {MAX_PAGES} pages")


def _group_runners(gid):
    return _list_all(f"/orgs/{ORG}/actions/runner-groups/{gid}/runners", "runners")


def _label_set(runner):
    labels = runner.get("labels")
    if not isinstance(labels, list) or not all(isinstance(l, dict) and isinstance(l.get("name"), str) for l in labels):
        return None
    return {l["name"].lower() for l in labels}


def _stale_candidate(name, gid):
    """The one same-name registration that is safe to delete, or exit for reconciliation.

    Safe means: exactly one org runner has this name, it is in this lane's group, has an
    integer id, is offline and not busy (both explicitly), and carries exactly the lane's
    labels. A busy, online, duplicated, foreign-group or odd-shaped one is never deleted.
    """
    matches = [r for r in _list_all(f"/orgs/{ORG}/actions/runners?name={name}", "runners")
               if isinstance(r, dict) and r.get("name") == name]
    if not matches:
        return None
    if len(matches) != 1:
        _exit(EX_RECONCILE, f"{len(matches)} runners are named {name}")
    runner = matches[0]
    rid = runner.get("id")
    if not isinstance(rid, int) or isinstance(rid, bool) or rid <= 0:
        _exit(EX_RECONCILE, f"runner {name} has no valid id")
    group_ids = {r.get("id") for r in _group_runners(gid) if isinstance(r, dict)}
    if rid not in group_ids:
        _exit(EX_RECONCILE, f"runner {name} is not in group {gid}")
    if runner.get("busy") is not False:
        _exit(EX_RECONCILE, f"runner {name} is busy or reports no busy state")
    if runner.get("status") != "offline":
        _exit(EX_RECONCILE, f"runner {name} is not offline")
    if _label_set(runner) != set(LABELS.split(",")):
        _exit(EX_RECONCILE, f"runner {name} does not carry exactly the lane labels")
    return rid


def mint(name, labels, gid):
    if not NAME_RE.match(name):
        _exit(EX_USAGE, "runner name must be ubuntu0-e2e-N")
    if labels != LABELS:
        _exit(EX_USAGE, "labels must be exactly " + LABELS)
    body = {"name": name, "runner_group_id": gid, "labels": labels.split(","), "work_folder": "_work"}
    status, data = _call("POST", f"/orgs/{ORG}/actions/runners/generate-jitconfig", body)
    if status == 409:
        # A previous one-job runner of this name never took a job (the slot stopped while it
        # was idle). Delete it only when it is provably that registration; then mint once more.
        rid = _stale_candidate(name, gid)
        if rid is not None:
            del_status, _ = _call("DELETE", f"/orgs/{ORG}/actions/runners/{rid}")
            if del_status not in (204, 404):
                _exit(EX_TEMPFAIL, f"delete stale runner HTTP {del_status}")
        status, data = _call("POST", f"/orgs/{ORG}/actions/runners/generate-jitconfig", body)
    if status != 201 or not isinstance(data, dict) or not data.get("encoded_jit_config"):
        _exit(EX_TEMPFAIL, f"generate-jitconfig HTTP {status}")
    sys.stdout.write(data["encoded_jit_config"])


def status(gid):
    for r in _group_runners(gid):
        labels = ",".join(sorted(_label_set(r) or ()))
        print(f"{r.get('name')} id={r.get('id')} {r.get('status')} busy={r.get('busy')} [{labels}]")


def check(gid):
    st, group = _call("GET", f"/orgs/{ORG}/actions/runner-groups/{gid}")
    if st != 200 or not isinstance(group, dict):
        _exit(EX_TEMPFAIL, f"read group HTTP {st}")
    print(f"group={group.get('name')} id={group.get('id')} visibility={group.get('visibility')} "
          f"allows_public_repositories={group.get('allows_public_repositories')} "
          f"restricted_to_workflows={group.get('restricted_to_workflows')}")
    repos = _list_all(f"/orgs/{ORG}/actions/runner-groups/{gid}/repositories", "repositories")
    print("repositories=" + ",".join(sorted(r["full_name"] for r in repos)))


def main(argv):
    if len(argv) == 5 and argv[1] == "mint":
        mint(argv[2], argv[3], _gid(argv[4]))
    elif len(argv) == 3 and argv[1] == "status":
        status(_gid(argv[2]))
    elif len(argv) == 3 and argv[1] == "check":
        check(_gid(argv[2]))
    else:
        _exit(EX_USAGE, "usage: mint-jitconfig mint <name> <labels> <gid> | status <gid> | check <gid>")


if __name__ == "__main__":
    main(sys.argv)
